# ---- Database ---------------------------------------------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=smartmenu

# ---- App --------------------------------------------------------------
# Public base URL of the app (used for QR codes, emails, payment callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---- Auth -------------------------------------------------------------
# REQUIRED. Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=your_long_random_secret_at_least_16_chars
# How long JWTs stay valid, in jsonwebtoken format (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# ---- AI & LLM ---------------------------------------------------------
NEXT_PUBLIC_AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here # optional

# ---- Real-time (Pusher) ------------------------------------------------
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=your_pusher_cluster
PUSHER_SECRET=your_pusher_secret
PUSHER_APP_ID=your_pusher_app_id

# ---- Media (Cloudinary) -----------------------------------------------
# Dashboard → Settings → API Keys. The secret stays on the server; browsers
# upload directly to Cloudinary with short-lived signatures from /api/media/sign.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---- Feature flags -----------------------------------------------------
NEXT_PUBLIC_AR_ENABLED=true
NEXT_PUBLIC_VISION_ENABLED=true
NEXT_PUBLIC_GAMIFICATION_ENABLED=true
NEXT_PUBLIC_USE_PUSHER=false

# ---- Payments (Nexi XPay) ----------------------------------------------
NEXI_XPAY_API_URL=https://your-nexi-xpay-endpoint
NEXI_XPAY_API_KEY=your_nexi_api_key

# ---- Email (Resend) ----------------------------------------------------
RESEND_API_KEY=your_resend_api_key # optional

# ---- Admin -------------------------------------------------------------
ADMIN_PASSWORD=your_secure_admin_password # optional
